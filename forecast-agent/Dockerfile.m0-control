# Daily scored-card control using the published M0 walk and unit-id seed.
# Build directly from the admitted image so the unvalidated online module is absent.
FROM forecast-agent:local-20260925
ENV AGENTHON_MONTHLY_TREND_AUTO=1
ENV AGENTHON_DAILY_M0_CONTROL=1
COPY forecast.py joint_model.py reference_model.py /app/
